{
  "name": "sentient-forms-admin-app",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/select-layout.mjs && vite dev",
    "build": "node scripts/select-layout.mjs && vite build",
    "preview": "node scripts/select-layout.mjs && vite preview",
    "preview:ci": "SENTIENT_FORMS_ROUTER=pathname bun run build && SENTIENT_FORMS_ROUTER=pathname node scripts/select-layout.mjs && SENTIENT_FORMS_ROUTER=pathname vite preview --host 127.0.0.1 --port 4173",
    "build:spa": "bun run build",
    "build:clean": "rimraf ../assets/dist",
    "build:copy": "node scripts/copy-build.mjs",
    "build:wp": "bun run build:clean && bun run build:spa && bun run build:copy",
    "bundle:check": "node scripts/bundle-check.mjs",
    "bundle:report": "BUNDLE_MAX_KB=999 node scripts/bundle-check.mjs",
    "tailwind:check": "node scripts/check-tailwind.mjs",
    "lint": "eslint \"{src,tests}/**/*.{ts,js}\" --max-warnings=0",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "node ./scripts/run-playwright-e2e.mjs",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "svelte:guard": "node scripts/svelte-guard.mjs",
    "qa:full": "bunx svelte-kit sync && bun run lint && bun run check && bun run svelte:guard && bun run tailwind:check && bun run test && bun run --bun e2e && bun run build:wp && bun run bundle:check",
    "qa:smoke": "bunx svelte-kit sync && bun run lint && bun run check && bun run svelte:guard && bun run tailwind:check && bun run test && bun run --bun e2e:smoke",
    "e2e:smoke": "node ./scripts/run-playwright-e2e.mjs --grep @smoke",
    "e2e:full": "node ./scripts/run-playwright-e2e.mjs --grep-invert @smoke",
    "preview:serve": "node scripts/select-layout.mjs && vite preview --host 127.0.0.1 --port 4175 --outDir build",
    "preview:e2e": "node scripts/preview-e2e.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@eslint/eslintrc": "^3.3.3",
    "@eslint/js": "^9.39.1",
    "@opentelemetry/api": "^1.9.0",
    "@playwright/test": "^1.57.0",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.49.0",
    "@sveltejs/vite-plugin-svelte": "^6.2.1",
    "@tailwindcss/forms": "^0.5.10",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.1.17",
    "@testing-library/svelte": "5.2.9",
    "@types/node": "^24.10.1",
    "@typescript-eslint/eslint-plugin": "^8.48.0",
    "@typescript-eslint/parser": "^8.48.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.13.0",
    "globals": "^16.5.0",
    "globby": "^16.0.0",
    "happy-dom": "^20.0.11",
    "jsdom": "^27.2.0",
    "prettier": "^3.7.3",
    "prettier-plugin-svelte": "^3.4.0",
    "rimraf": "^6.1.2",
    "svelte": "^5.45.2",
    "svelte-check": "^4.3.4",
    "svelte-eslint-parser": "^1.4.0",
    "tailwindcss": "^4.1.17",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "npm:rolldown-vite@7.2.9",
    "vitest": "^4.0.14"
  },
  "packageManager": "bun@1.3.0",
  "dependencies": {
    "@dagrejs/dagre": "^1.1.8",
    "@lucide/svelte": "^1.14.0",
    "@xyflow/svelte": "^1.5.0",
    "zod": "^4.3.5"
  }
}
