{
  "name": "sentient-forms-admin-app",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/select-layout.mjs && vite dev",
    "build": "node scripts/select-layout.mjs && vite build",
    "preview": "node scripts/select-layout.mjs && vite preview",
    "preview:ci": "SENTIENT_FORMS_ROUTER=pathname bun run build && SENTIENT_FORMS_ROUTER=pathname node scripts/select-layout.mjs && SENTIENT_FORMS_ROUTER=pathname vite preview --host 127.0.0.1 --port 4173",
    "build:spa": "bun run build",
    "build:clean": "rimraf ../assets/dist",
    "build:copy": "node scripts/copy-build.mjs",
    "build:wp": "bun run build:clean && bun run build:spa && bun run build:copy",
    "bundle:check": "node scripts/bundle-check.mjs",
    "bundle:report": "BUNDLE_MAX_KB=999 node scripts/bundle-check.mjs",
    "tailwind:check": "node scripts/check-tailwind.mjs",
    "lint": "eslint \"{src,tests}/**/*.{ts,js}\" --max-warnings=0",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "svelte:guard": "node scripts/svelte-guard.mjs",
    "qa:full": "bunx svelte-kit sync && bun run lint && bun run check && bun run svelte:guard && bun run tailwind:check && bun run test && bun run e2e:smoke && bun run build:wp && bun run bundle:check",
    "qa:smoke": "bunx svelte-kit sync && bun run lint && bun run check && bun run svelte:guard && bun run tailwind:check && bun run test && playwright test --grep @smoke",
    "e2e:smoke": "playwright test --grep @smoke",
    "e2e:full": "playwright test --grep-invert @smoke",
    "preview:serve": "node scripts/select-layout.mjs && vite preview --host 127.0.0.1 --port 4173"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.11.0",
    "@opentelemetry/api": "^1.9.0",
    "@playwright/test": "^1.48.2",
    "@sveltejs/adapter-static": "^3.0.3",
    "@sveltejs/kit": "^2.7.0",
    "@sveltejs/vite-plugin-svelte": "^4.0.0",
    "@tailwindcss/forms": "^0.5.10",
    "@tailwindcss/typography": "^0.5.19",
    "@testing-library/svelte": "4.2.2",
    "@types/node": "^22.7.4",
    "@typescript-eslint/eslint-plugin": "^8.46.2",
    "@typescript-eslint/parser": "^8.46.2",
    "autoprefixer": "^10.4.20",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "eslint": "^9.11.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-svelte": "^2.44.1",
    "globals": "^15.9.0",
    "globby": "^15.0.0",
    "happy-dom": "^20.0.7",
    "jsdom": "^27.0.1",
    "postcss": "^8.4.47",
    "prettier": "^3.3.3",
    "prettier-plugin-svelte": "^3.2.5",
    "rimraf": "^6.0.1",
    "svelte": "^5.1.0",
    "svelte-check": "^4.0.3",
    "svelte-eslint-parser": "^1.4.0",
    "tailwindcss": "^3.4.13",
    "tslib": "^2.7.0",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.7.0",
    "vite": "^5.4.5",
    "vitest": "^1.6.0"
  },
  "packageManager": "bun@1.3.0"
}
