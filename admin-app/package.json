{
  "name": "sentient-forms-admin-app",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --host",
    "build": "vite build",
    "preview": "vite preview --host",
    "build:spa": "bun run build",
    "build:clean": "rimraf ../assets/dist/*",
    "build:copy": "node scripts/copy-build.mjs",
    "build:wp": "bun run build:clean && bun run build:spa && bun run build:copy",
    "lint": "eslint \"{src,tests}/**/*.{ts,js}\" --max-warnings=0",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "format": "prettier --check .",
    "format:write": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.11.0",
    "@opentelemetry/api": "^1.9.0",
    "@playwright/test": "^1.48.2",
    "@sveltejs/adapter-static": "^3.0.3",
    "@sveltejs/kit": "^2.7.0",
    "@sveltejs/vite-plugin-svelte": "^4.0.0",
    "@tailwindcss/postcss": "^4.1.15",
    "@types/node": "^22.7.4",
    "@typescript-eslint/eslint-plugin": "^8.46.2",
    "@typescript-eslint/parser": "^8.46.2",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.11.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-svelte": "^2.44.1",
    "globals": "^15.9.0",
    "jsdom": "^27.0.1",
    "postcss": "^8.4.47",
    "prettier": "^3.3.3",
    "prettier-plugin-svelte": "^3.2.5",
    "rimraf": "^6.0.1",
    "svelte": "^5.1.0",
    "svelte-check": "^4.0.3",
    "svelte-eslint-parser": "^1.4.0",
    "tailwindcss": "^4.0.0-alpha.13",
    "tslib": "^2.7.0",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.7.0",
    "vite": "^5.4.5",
    "vitest": "^1.6.0"
  },
  "packageManager": "bun@1.3.0"
}
