{
    "name": "sentient/forms",
  "require-dev": {
    "phpunit/phpunit": "^9",
    "wp-phpunit/wp-phpunit": "^6",
    "yoast/phpunit-polyfills": "^4.0",
    "squizlabs/php_codesniffer": "^3.10",
    "wp-coding-standards/wpcs": "^3.0"
  },
  "scripts": {
    "phpcs": "vendor/bin/phpcs --standard=phpcs-rulesets/SentientForms.xml",
    "phpcbf": "vendor/bin/phpcbf --standard=phpcs-rulesets/SentientForms.xml"
  },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "require": {
        "woocommerce/action-scheduler": "^3.8"
    }
}
