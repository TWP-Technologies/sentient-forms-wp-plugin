{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sentientforms.com/contracts/v2/billing/top-up-checkout-session-success.schema.json",
  "title": "Sentient Billing Top-Up Checkout Session Success",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "success",
    "data"
  ],
  "properties": {
    "success": {
      "type": "boolean",
      "const": true
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "session_id",
        "checkout_url",
        "customer_id",
        "top_up_credits",
        "pack_code"
      ],
      "properties": {
        "session_id": {
          "type": "string",
          "minLength": 1
        },
        "checkout_url": {
          "type": "string",
          "format": "uri"
        },
        "customer_id": {
          "type": "string",
          "minLength": 1
        },
        "top_up_credits": {
          "type": "integer",
          "minimum": 1
        },
        "pack_code": {
          "type": "string",
          "enum": [
            "top_up_small",
            "top_up_medium",
            "top_up_large"
          ]
        }
      }
    }
  }
}
