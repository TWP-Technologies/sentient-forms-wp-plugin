{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sentientforms.com/contracts/v2/billing/checkout-session-request.schema.json",
  "title": "Sentient Billing Checkout Session Request",
  "type": "object",
  "required": [
    "success_url",
    "cancel_url"
  ],
  "anyOf": [
    {
      "required": [
        "price_id"
      ]
    },
    {
      "required": [
        "plan_code"
      ]
    }
  ],
  "properties": {
    "price_id": {
      "type": "string",
      "minLength": 1
    },
    "plan_code": {
      "type": "string",
      "minLength": 1
    },
    "success_url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https?://"
    },
    "cancel_url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https?://"
    },
    "quantity": {
      "type": "integer",
      "minimum": 1
    },
    "trial_period_days": {
      "type": "integer",
      "maximum": 0
    },
    "allow_promotion_codes": {
      "type": "boolean"
    },
    "customer_email": {
      "type": "string"
    },
    "customer_name": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
