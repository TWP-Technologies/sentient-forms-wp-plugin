{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sentientforms.com/contracts/v2/billing/checkout-session-request.schema.json",
  "title": "Sentient Billing Checkout Session Request",
  "type": "object",
  "required": [
    "plan_code",
    "success_url",
    "cancel_url",
    "checkout_attempt_id"
  ],
  "properties": {
    "price_id": false,
    "plan_code": {
      "type": "string",
      "enum": [
        "starter",
        "pro",
        "business"
      ]
    },
    "success_url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https?://"
    },
    "cancel_url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https?://"
    },
    "quantity": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1
    },
    "trial_period_days": {
      "type": "integer",
      "minimum": 0,
      "maximum": 0
    },
    "allow_promotion_codes": {
      "type": "boolean"
    },
    "customer_email": {
      "type": "string"
    },
    "customer_name": {
      "type": "string"
    },
    "checkout_attempt_id": {
      "type": "string",
      "format": "uuid",
      "description": "Client-generated identifier for one checkout attempt. Reuse it only when retrying that same attempt."
    }
  },
  "additionalProperties": true
}
