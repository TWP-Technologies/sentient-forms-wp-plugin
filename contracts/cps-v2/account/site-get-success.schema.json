{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sentientforms.com/contracts/v2/account/site-get-success.schema.json",
  "title": "Sentient Account Site Success",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "success",
    "data"
  ],
  "properties": {
    "success": {
      "type": "boolean",
      "const": true
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "service",
        "site_id",
        "license_id",
        "site_url",
        "local_site_identifier",
        "license_status",
        "tier",
        "telemetry_opt_in",
        "billing_boundary"
      ],
      "properties": {
        "service": {
          "type": "string",
          "const": "sentient-managed"
        },
        "site_id": {
          "type": "string",
          "format": "uuid"
        },
        "license_id": {
          "type": "string",
          "format": "uuid"
        },
        "site_url": {
          "type": "string",
          "format": "uri"
        },
        "local_site_identifier": {
          "type": "string",
          "minLength": 1
        },
        "license_status": {
          "type": "string",
          "enum": [
            "active",
            "trial",
            "suspended",
            "revoked",
            "expired"
          ]
        },
        "tier": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "code",
            "display_name",
            "description",
            "site_limit",
            "monthly_credit_quota"
          ],
          "properties": {
            "id": {
              "type": "string",
              "format": "uuid"
            },
            "code": {
              "type": "string",
              "minLength": 1
            },
            "display_name": {
              "type": "string",
              "minLength": 1
            },
            "description": {
              "type": "string"
            },
            "site_limit": {
              "type": "integer"
            },
            "monthly_credit_quota": {
              "type": "integer"
            }
          }
        },
        "telemetry_opt_in": {
          "type": "boolean"
        },
        "billing_boundary": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "direct_openrouter_billed_by_sentient",
            "managed_proxy_billed_by_sentient"
          ],
          "properties": {
            "direct_openrouter_billed_by_sentient": {
              "type": "boolean",
              "const": false
            },
            "managed_proxy_billed_by_sentient": {
              "type": "boolean",
              "const": true
            }
          }
        }
      }
    }
  }
}
