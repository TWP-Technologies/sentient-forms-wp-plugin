{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sentientforms.com/contracts/v2/managed/execute-request.schema.json",
  "title": "Sentient Managed Execute Request",
  "type": "object",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "tool_choice": {
            "const": "required"
          }
        },
        "required": [
          "tool_choice"
        ]
      },
      "then": {
        "properties": {
          "tools": {
            "minItems": 1
          }
        },
        "required": [
          "tools"
        ]
      }
    }
  ],
  "required": [
    "site_id",
    "execution_request_id",
    "model",
    "prompt"
  ],
  "properties": {
    "site_id": {
      "type": "string",
      "format": "uuid"
    },
    "execution_request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "provider": {
      "type": "string",
      "const": "sentient_managed"
    },
    "model": {
      "type": "string",
      "minLength": 1,
      "maxLength": 191
    },
    "action_code": {
      "type": "string",
      "minLength": 1,
      "maxLength": 191
    },
    "prompt": {
      "type": "string",
      "minLength": 1
    },
    "output_contract": {
      "type": "object"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "string",
          "number",
          "integer",
          "boolean",
          "null"
        ]
      }
    },
    "temperature": {
      "type": "number"
    },
    "max_output_tokens": {
      "type": "integer",
      "minimum": 1,
      "maximum": 16384
    },
    "timeout_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 300
    },
    "reasoning": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "effort"
      ],
      "properties": {
        "effort": {
          "type": "string",
          "enum": [
            "none",
            "minimal",
            "low",
            "medium",
            "high",
            "xhigh"
          ]
        },
        "exclude": {
          "type": "boolean",
          "const": true
        }
      }
    },
    "tools": {
      "type": "array",
      "minItems": 0,
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": [
          "type"
        ],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "openrouter:web_search",
              "openrouter:web_fetch",
              "openrouter:datetime"
            ]
          }
        },
        "additionalProperties": true
      }
    },
    "tool_choice": {
      "type": "string",
      "enum": [
        "auto",
        "required",
        "none"
      ]
    },
    "privacy_route_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "require_zdr",
        "data_collection"
      ],
      "properties": {
        "schema": {
          "type": "string",
          "const": "sentient_forms_privacy_route_policy.v1"
        },
        "require_zdr": {
          "type": "boolean",
          "const": true
        },
        "data_collection": {
          "type": "string",
          "const": "deny"
        }
      }
    },
    "managed_capability_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "required_capabilities"
      ],
      "properties": {
        "schema": {
          "type": "string",
          "const": "sentient_forms_managed_capability_policy.v1"
        },
        "required_capabilities": {
          "type": "array",
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "server_tools",
              "web_search",
              "privacy_zdr",
              "bounded_output"
            ]
          }
        }
      }
    }
  }
}
