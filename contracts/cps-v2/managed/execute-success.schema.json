{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sentientforms.com/contracts/v2/managed/execute-success.schema.json",
  "title": "Sentient Managed Execute Success",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "success",
    "data"
  ],
  "properties": {
    "success": {
      "type": "boolean",
      "const": true
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "dependentRequired": {
        "privacy_route_fallback": [
          "privacy_route_assertion"
        ]
      },
      "allOf": [
        {
          "if": {
            "required": [
              "privacy_route_fallback"
            ]
          },
          "then": {
            "required": [
              "privacy_route_assertion"
            ],
            "properties": {
              "status": {
                "const": "succeeded"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "succeeded"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "provider",
              "model",
              "output",
              "token_usage"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "settled"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "replay",
              "response_digest"
            ]
          }
        }
      ],
      "required": [
        "execution_request_id",
        "status",
        "metering"
      ],
      "properties": {
        "execution_request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "provider": {
          "type": "string",
          "const": "sentient_managed"
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 191
        },
        "status": {
          "type": "string",
          "enum": [
            "succeeded",
            "settled"
          ]
        },
        "replay": {
          "type": "boolean",
          "const": true
        },
        "response_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "output": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "text"
          ],
          "properties": {
            "text": {
              "type": "string"
            }
          }
        },
        "token_usage": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "input_tokens",
            "output_tokens",
            "total_tokens"
          ],
          "properties": {
            "input_tokens": {
              "type": "integer",
              "minimum": 0
            },
            "output_tokens": {
              "type": "integer",
              "minimum": 0
            },
            "total_tokens": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "metering": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "event_id",
            "free_usage",
            "pricing_policy_version",
            "debited_credits"
          ],
          "properties": {
            "event_id": {
              "type": "string",
              "format": "uuid"
            },
            "free_usage": {
              "type": "boolean"
            },
            "pricing_policy_version": {
              "type": "string"
            },
            "debited_credits": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "privacy_route_assertion": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schema",
            "zdr_enforced",
            "data_collection",
            "route_policy_schema"
          ],
          "properties": {
            "schema": {
              "type": "string",
              "const": "sentient_forms_privacy_route_assertion.v1"
            },
            "zdr_enforced": {
              "type": "boolean",
              "const": true
            },
            "data_collection": {
              "type": "string",
              "const": "deny"
            },
            "route_policy_schema": {
              "type": "string",
              "const": "sentient_forms_privacy_route_policy.v1"
            }
          }
        },
        "privacy_route_fallback": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schema",
            "policy_version",
            "reason_code",
            "original_model",
            "fallback_model",
            "executed_model",
            "attempts"
          ],
          "properties": {
            "schema": {
              "type": "string",
              "const": "sentient_forms_privacy_route_fallback.v1"
            },
            "policy_version": {
              "type": "string",
              "minLength": 1
            },
            "reason_code": {
              "type": "string",
              "const": "managed_zdr_primary_route_unavailable"
            },
            "original_model": {
              "type": "string",
              "minLength": 1,
              "maxLength": 191
            },
            "fallback_model": {
              "type": "string",
              "minLength": 1,
              "maxLength": 191
            },
            "executed_model": {
              "type": "string",
              "minLength": 1,
              "maxLength": 191
            },
            "attempts": {
              "type": "integer",
              "minimum": 1,
              "maximum": 16
            }
          }
        }
      }
    }
  }
}
